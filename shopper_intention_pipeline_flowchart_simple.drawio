<mxfile host="Electron" agent="Antigravity">
  <diagram name="Shopper Intention ML Pipeline Flowchart" id="shopper-intention-pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 1. Terminal: START -->
        <mxCell id="step-1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=13;" value="&lt;b&gt;START&lt;/b&gt;" vertex="1">
          <mxGeometry height="45" width="160" x="420" y="35" as="geometry" />
        </mxCell>

        <!-- 2. Input / Data: Raw Dataset -->
        <mxCell id="step-2" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=12;" value="&lt;b&gt;Raw Dataset&lt;/b&gt;" vertex="1">
          <mxGeometry height="45" width="240" x="380" y="115" as="geometry" />
        </mxCell>

        <!-- 3. Process: EDA -->
        <mxCell id="step-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;" value="&lt;b&gt;Exploratory Data Analysis (EDA)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; font-weight: normal;&quot;&gt;Statistical distributions, correlations, skewness, &amp;amp; class imbalance inspection&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="400" x="300" y="195" as="geometry" />
        </mxCell>

        <!-- 4. Process: Data Preprocessing (Pre-Split) -->
        <mxCell id="step-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;" value="&lt;b&gt;Data Preprocessing (Pre-Split)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; font-weight: normal;&quot;&gt;Deduplication, business rules validation, duration consistency, capping, rate clipping, category grouping, &amp;amp; dropping SpecialDay&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="460" x="270" y="280" as="geometry" />
        </mxCell>

        <!-- 5. Process: Train / Test Split -->
        <mxCell id="step-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;" value="&lt;b&gt;Train / Test Split&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; font-weight: normal;&quot;&gt;Stratified 80/20 split (Preserves 5.5:1 class ratio)&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="400" x="300" y="375" as="geometry" />
        </mxCell>

        <!-- 6. Decision: Algorithm-Specific Route? -->
        <mxCell id="step-6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;" value="&lt;b&gt;Algorithm-Specific&lt;br&gt;Route?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 8.5px; font-weight: normal;&quot;&gt;Branch into independent&lt;br&gt;model training pipelines&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="220" x="390" y="460" as="geometry" />
        </mxCell>

        <!-- 7a. Process (Branch 1): XGBoost Pipeline -->
        <mxCell id="step-7a" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;" value="&lt;b&gt;XGBoost Pipeline&lt;/b&gt;&lt;br&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 8.5px; font-weight: normal; padding-left: 8px;&quot;&gt;• &lt;b&gt;Outlier:&lt;/b&gt; Skip (Tree invariant)&lt;br&gt;• &lt;b&gt;Encoding:&lt;/b&gt; Categorical One-Hot / Passthrough numerical&lt;br&gt;• &lt;b&gt;Resampling:&lt;/b&gt; SMOTE in 5-fold CV&lt;br&gt;• &lt;b&gt;Tuning:&lt;/b&gt; Particle Swarm Optimization (PSO)&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="280" x="50" y="600" as="geometry" />
        </mxCell>

        <!-- 7b. Process (Branch 2): SVM Pipeline -->
        <mxCell id="step-7b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;" value="&lt;b&gt;SVM Pipeline&lt;/b&gt;&lt;br&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 8.5px; font-weight: normal; padding-left: 8px;&quot;&gt;• &lt;b&gt;Outlier:&lt;/b&gt; Training-only IQR filtering&lt;br&gt;• &lt;b&gt;Encoding:&lt;/b&gt; One-Hot + Yeo-Johnson &amp;amp; StandardScaler&lt;br&gt;• &lt;b&gt;Imbalance:&lt;/b&gt; Joint SMOTENC / Cost-sensitive weighting&lt;br&gt;• &lt;b&gt;Post-processing:&lt;/b&gt; Platt Scaling + OOF Threshold Opt.&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="280" x="360" y="600" as="geometry" />
        </mxCell>

        <!-- 7c. Process (Branch 3): KNN + RF Ensemble -->
        <mxCell id="step-7c" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;align=center;verticalAlign=middle;" value="&lt;b&gt;KNN + Random Forest Ensemble&lt;/b&gt;&lt;br&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 8.5px; font-weight: normal; padding-left: 8px;&quot;&gt;• &lt;b&gt;Outlier:&lt;/b&gt; Training-only IQR filtering&lt;br&gt;• &lt;b&gt;Encoding:&lt;/b&gt; One-Hot + Yeo-Johnson &amp;amp; StandardScaler&lt;br&gt;• &lt;b&gt;Resampling:&lt;/b&gt; SMOTE in 5-fold CV&lt;br&gt;• &lt;b&gt;Ensemble:&lt;/b&gt; Stacking via Logistic Reg. + Platt Calib.&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="280" x="670" y="600" as="geometry" />
        </mxCell>

        <!-- 8. Process: Model Evaluation -->
        <mxCell id="step-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;" value="&lt;b&gt;Model Evaluation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; font-weight: normal;&quot;&gt;Evaluate all models on held-out test set&lt;br&gt;(Accuracy, Precision, Recall, F1, ROC-AUC, Confusion Matrix, &amp;amp; SHAP)&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="460" x="270" y="765" as="geometry" />
        </mxCell>

        <!-- 9. Output: Live Prediction -->
        <mxCell id="step-9" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;" value="&lt;b&gt;Live Prediction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; font-weight: normal;&quot;&gt;Multi-model consensus engine, test-set sampler, &amp;amp; calibrated probability meter&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="460" x="270" y="860" as="geometry" />
        </mxCell>

        <!-- 10. Terminal: END -->
        <mxCell id="step-10" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=13;" value="&lt;b&gt;END&lt;/b&gt;" vertex="1">
          <mxGeometry height="45" width="160" x="420" y="955" as="geometry" />
        </mxCell>

        <!-- CONNECTORS / EDGES -->
        <!-- 1 -> 2 -->
        <mxCell id="edge-1-2" edge="1" parent="1" source="step-1" target="step-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=classic;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2 -> 3 -->
        <mxCell id="edge-2-3" edge="1" parent="1" source="step-2" target="step-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=classic;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3 -> 4 -->
        <mxCell id="edge-3-4" edge="1" parent="1" source="step-3" target="step-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=classic;">
          <mxGeometry relative="1" as="geometry" />
