<mxfile host="Electron" agent="Antigravity">
  <diagram name="Shopper Intention ML Pipeline Flowchart" id="shopper-intention-pipeline">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 1. Terminal: START -->
        <mxCell id="step-1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=15;" value="&lt;b&gt;START&lt;/b&gt;" vertex="1">
          <mxGeometry height="46" width="180" x="324" y="35" as="geometry" />
        </mxCell>

        <!-- 2. Input / Data: Raw Dataset -->
        <mxCell id="step-2" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=14;" value="&lt;b&gt;Raw Dataset&lt;/b&gt;" vertex="1">
          <mxGeometry height="46" width="260" x="284" y="105" as="geometry" />
        </mxCell>

        <!-- 3. Process: Exploratory Data Analysis (EDA) -->
        <mxCell id="step-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=13;" value="&lt;b style=&quot;font-size: 13.5px;&quot;&gt;Exploratory Data Analysis (EDA)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;Statistical distributions, correlations, skewness, &amp;amp; class imbalance inspection&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="480" x="174" y="175" as="geometry" />
        </mxCell>

        <!-- 4. Process: Data Preprocessing (Pre-Split) -->
        <mxCell id="step-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=13;" value="&lt;b style=&quot;font-size: 13.5px;&quot;&gt;Data Preprocessing (Pre-Split)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;Deduplication, business rules validation, duration consistency, capping, rate clipping, grouping, &amp;amp; drop SpecialDay&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="520" x="154" y="260" as="geometry" />
        </mxCell>

        <!-- 5. Process: Train / Test Split -->
        <mxCell id="step-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=13;" value="&lt;b style=&quot;font-size: 13.5px;&quot;&gt;Train / Test Split&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;Stratified 80/20 split preserving 5.5:1 class ratio&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="480" x="174" y="348" as="geometry" />
        </mxCell>

        <!-- 6. Decision: Algorithm-Specific Route? -->
        <mxCell id="step-6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=12;" value="&lt;b style=&quot;font-size: 13.5px;&quot;&gt;Algorithm-Specific&lt;br&gt;Route?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px; font-weight: normal;&quot;&gt;Branch into independent&lt;br&gt;model training pipelines&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="290" x="269" y="430" as="geometry" />
        </mxCell>

        <!-- 7a. Process (Branch 1): XGBoost Pipeline -->
        <mxCell id="step-7a" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;XGBoost Pipeline&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10.5px; font-weight: normal; margin-top: 5px; padding: 0 4px; line-height: 1.3;&quot;&gt;Skip outliers, One-Hot categorical passthrough numerical, 5-fold CV SMOTE, &amp;amp; PSO hyperparameter tuning&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="234" x="36" y="565" as="geometry" />
        </mxCell>

        <!-- 7b. Process (Branch 2): SVM Pipeline -->
        <mxCell id="step-7b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;SVM Pipeline&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10.5px; font-weight: normal; margin-top: 5px; padding: 0 4px; line-height: 1.3;&quot;&gt;Training IQR filter, One-Hot + Yeo-Johnson &amp;amp; scaling, joint SMOTENC/weighting, Platt scaling, &amp;amp; OOF threshold&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="234" x="296" y="565" as="geometry" />
        </mxCell>

        <!-- 7c. Process (Branch 3): KNN + RF Ensemble -->
        <mxCell id="step-7c" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;KNN + Random Forest Ensemble&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10.5px; font-weight: normal; margin-top: 5px; padding: 0 4px; line-height: 1.3;&quot;&gt;Training IQR filter, One-Hot + Yeo-Johnson &amp;amp; scaling, 5-fold CV SMOTE, Stacking ensemble, &amp;amp; Platt calibration&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="234" x="556" y="565" as="geometry" />
        </mxCell>

        <!-- 8. Process: Model Evaluation -->
        <mxCell id="step-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=13;" value="&lt;b style=&quot;font-size: 13.5px;&quot;&gt;Model Evaluation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;Evaluate all models on held-out test set via classification metrics, confusion matrix, &amp;amp; SHAP&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="520" x="154" y="735" as="geometry" />
        </mxCell>

        <!-- 9. Output: Live Prediction -->
        <mxCell id="step-9" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=13;" value="&lt;b style=&quot;font-size: 13.5px;&quot;&gt;Live Prediction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;Multi-model consensus engine, test-set sampler, &amp;amp; calibrated probability meter&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="520" x="154" y="827" as="geometry" />
        </mxCell>

        <!-- 10. Terminal: END -->
        <mxCell id="step-10" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;strokeWidth=2;fontSize=15;" value="&lt;b&gt;END&lt;/b&gt;" vertex="1">
          <mxGeometry height="46" width="180" x="324" y="920" as="geometry" />
        </mxCell>

